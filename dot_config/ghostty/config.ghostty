# ── Splits (tmux-style panes, no tmux needed) ──────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom      # maximize the current pane
keybind = cmd+shift+e=equalize_splits
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# ── Tabs ───────────────────────────────────────────────────
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+shift+t=prompt_surface_title       # rename the tab, e.g. "api", "logs"

# ── Quick terminal (system-wide dropdown) ──────────────────
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ── Jump between commands (needs shell integration) ────────
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# ── Scrollback and output ──────────────────────────────────
keybind = cmd+k=clear_screen
keybind = cmd+home=scroll_to_top
keybind = cmd+end=scroll_to_bottom
keybind = cmd+shift+s=write_scrollback_file:open  # open the whole scrollback in your editor
keybind = cmd+shift+p=write_scrollback_file:paste # paste its file path at the prompt

# ── Editing the command line like an IDE ───────────────────
keybind = alt+left=esc:b                          # back one word
keybind = alt+right=esc:f                         # forward one word
keybind = cmd+left=text:\x01                      # start of line
keybind = cmd+right=text:\x05                     # end of line
keybind = alt+backspace=text:\x1b\x7f             # delete a word
keybind = cmd+backspace=text:\x15                 # delete the whole line

# ── AI CLIs (Claude Code etc.): newline without submitting ─
keybind = shift+enter=text:\x1b\r

# ── Config and debugging ───────────────────────────────────
keybind = cmd+shift+comma=reload_config
keybind = cmd+alt+i=inspector:toggle              # terminal inspector (keys, fonts, cells)
keybind = cmd+shift+a=toggle_command_palette      # Ghostty 1.2

theme = dark:solarized-dark,light:solarized-light
